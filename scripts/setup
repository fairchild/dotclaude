#!/usr/bin/env bash
#MISE description="Install runtimes and deps from .mise.toml"
set -euo pipefail

# Copy secrets from conductor root if available
[[ -n "${CONDUCTOR_ROOT_PATH:-}" && -f "$CONDUCTOR_ROOT_PATH/.env" ]] && cp "$CONDUCTOR_ROOT_PATH/.env" .env

# Runtimes and tools from .mise.toml
mise trust && mise install

# Python deps (core only, optional groups are lazy)
uv sync --no-dev
