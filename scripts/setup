#!/usr/bin/env bash
#MISE description="Install deps, link env"
set -euo pipefail

# Copy secrets from conductor root if available
[[ -n "${CONDUCTOR_ROOT_PATH:-}" && -f "$CONDUCTOR_ROOT_PATH/.env" ]] && cp "$CONDUCTOR_ROOT_PATH/.env" .env

# Trust mise if present
[[ -f .mise.toml || -f mise.toml ]] && mise trust && mise install

# Install dependencies (skip if already synced)
uv sync
