{
  "name": "managed-agents-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted environment for Claude managed agents on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
