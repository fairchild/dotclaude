{
  "name": "dotclaude-pr-review",
  "description": "Reviews pull requests in the dotclaude repository against the project's writing, code, and skill conventions.",
  "model": "claude-sonnet-4-6",
  "system_prompt_file": "system-prompt.md",
  "tools": [
    {
      "type": "custom",
      "name": "pr_diff",
      "description": "Return the unified diff of a pull request as text.",
      "input_schema": {
        "type": "object",
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "pull_number": { "type": "integer", "exclusiveMinimum": 0 }
        },
        "required": ["owner", "repo", "pull_number"]
      }
    },
    {
      "type": "custom",
      "name": "pr_files",
      "description": "List files changed in a pull request with per-file additions, deletions, status, and patch. Returns up to 100 files.",
      "input_schema": {
        "type": "object",
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "pull_number": { "type": "integer", "exclusiveMinimum": 0 }
        },
        "required": ["owner", "repo", "pull_number"]
      }
    },
    {
      "type": "custom",
      "name": "pr_post_review",
      "description": "Post a pull request review. event chooses the verdict: APPROVE, REQUEST_CHANGES, or COMMENT. body is the top-level summary; comments are optional inline file/line comments.",
      "input_schema": {
        "type": "object",
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "pull_number": { "type": "integer", "exclusiveMinimum": 0 },
          "event": { "type": "string", "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT"] },
          "body": { "type": "string", "minLength": 1 },
          "comments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "line": { "type": "integer", "exclusiveMinimum": 0 },
                "body": { "type": "string", "minLength": 1 }
              },
              "required": ["path", "line", "body"]
            }
          }
        },
        "required": ["owner", "repo", "pull_number", "event", "body"]
      }
    },
    {
      "type": "custom",
      "name": "http_get",
      "description": "Fetch a URL with HTTP GET and return the response body as text. Outbound traffic passes through the egress layer.",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "max_bytes": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1000000 }
        },
        "required": ["url"]
      }
    }
  ]
}
