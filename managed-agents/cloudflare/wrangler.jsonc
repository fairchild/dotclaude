{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managed-agents-cloudflare",
  "main": "runtime/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // KV namespaces back the egress layer:
  //   SECRETS: { reference_name -> secret_value }
  //   EGRESS_POLICIES: { policy_id -> rule_json }
  //   AGENT_INBOX: { agent_address -> inbound_message }
  // These are the live namespaces in the "irons in the fire" account. Namespace
  // ids are resource identifiers, not credentials — they grant nothing without
  // account auth. Committing them is what makes `wrangler deploy` reproducible
  // from a clean checkout; the previous REPLACE_ME placeholders meant a deploy
  // from the repo would silently ship a worker with invalid bindings.
  // Deploying into a different account: run `bun run scripts/ensure-kv.mjs` and
  // swap the ids below.
  "kv_namespaces": [
    { "binding": "SECRETS", "id": "dffe42fc29f94490b8db1dcfecf6e2a5" },
    { "binding": "EGRESS_POLICIES", "id": "cca57bb79ef64944b0a29d4472f3e8aa" },
    { "binding": "AGENT_INBOX", "id": "acc8b07e5c694058bd1e1d24d1e0e350" }
  ],

  // Worker Loader binding for per-session isolates lands in V1.1 - the runner
  // is a scaffold in V1 (see runtime/isolate/runner.ts). Uncomment once the
  // exact binding shape is verified against current wrangler:
  //
  //   "unsafe": {
  //     "bindings": [{ "name": "ISOLATE_LOADER", "type": "worker_loader" }]
  //   },

  // The account is selected via the CLOUDFLARE_ACCOUNT_ID env var rather than a
  // committed account_id, since this login can see more than one account and
  // wrangler refuses to guess in non-interactive mode. The value already lives
  // in the repo's CLOUDFLARE_ACCOUNT_ID Actions variable.
  //
  // Secrets (set with `wrangler secret put <NAME>`):
  //   ANTHROPIC_ENVIRONMENT_ID         scoping for the work queue
  //   ANTHROPIC_ENVIRONMENT_KEY        Bearer auth for /work endpoints
  //   ANTHROPIC_WEBHOOK_SIGNING_KEY    verifies inbound webhook signatures
  "vars": {
    "ANTHROPIC_API_BASE": "https://api.anthropic.com",
    "ANTHROPIC_BETA_HEADER": "managed-agents-2026-04-01",
    "EMAIL_DOMAIN": "example.com"
  },

  "observability": {
    "enabled": true
  }
}
