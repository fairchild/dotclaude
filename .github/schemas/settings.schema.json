{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fairchild/dotclaude/schemas/settings.schema.json",
  "title": "Claude Code Settings",
  "description": "Schema for Claude Code settings.json configuration file",
  "type": "object",
  "properties": {
    "env": {
      "type": "object",
      "description": "Environment variables to set",
      "additionalProperties": { "type": "string" }
    },
    "autoMode": {
      "type": "object",
      "description": "Auto mode classifier customization",
      "properties": {
        "allow": {
          "type": "array",
          "description": "Classifier allow rules; \"$defaults\" inherits the built-ins at that position",
          "items": { "type": "string" }
        },
        "soft_deny": {
          "type": "array",
          "description": "Destructive actions that user intent can clear",
          "items": { "type": "string" }
        },
        "hard_deny": {
          "type": "array",
          "description": "Security boundaries that user intent does not clear",
          "items": { "type": "string" }
        },
        "environment": {
          "type": "array",
          "description": "Classifier environment entries",
          "items": { "type": "string" }
        },
        "classifyAllShell": {
          "type": "boolean",
          "description": "Suspend every Bash allow rule while auto mode is active"
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "description": "Tool and command access permissions",
      "properties": {
        "allow": {
          "type": "array",
          "description": "Patterns to always allow",
          "items": { "type": "string" }
        },
        "deny": {
          "type": "array",
          "description": "Patterns to always deny",
          "items": { "type": "string" }
        },
        "ask": {
          "type": "array",
          "description": "Patterns requiring user confirmation",
          "items": { "type": "string" }
        },
        "defaultMode": {
          "type": "string",
          "enum": [
            "acceptEdits",
            "auto",
            "bypassPermissions",
            "default",
            "dontAsk",
            "plan"
          ],
          "description": "Default permission mode when Claude Code needs access"
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "description": "Lifecycle hooks",
      "properties": {
        "PreCompact": { "$ref": "#/definitions/hookArray" },
        "SessionStart": { "$ref": "#/definitions/hookArray" },
        "Stop": { "$ref": "#/definitions/hookArray" },
        "PreToolUse": { "$ref": "#/definitions/hookArray" },
        "PostToolUse": { "$ref": "#/definitions/hookArray" }
      },
      "additionalProperties": { "$ref": "#/definitions/hookArray" }
    },
    "statusLine": {
      "type": "object",
      "description": "Custom status line configuration",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["command"],
          "description": "Status line type"
        },
        "command": {
          "type": "string",
          "description": "Command to execute for status line"
        },
        "refreshInterval": {
          "type": "integer",
          "minimum": 0,
          "description": "Refresh interval in milliseconds"
        }
      },
      "required": ["type", "command"],
      "additionalProperties": false
    },
    "alwaysThinkingEnabled": {
      "type": "boolean",
      "description": "Enable always-thinking mode"
    },
    "model": {
      "type": "string",
      "description": "Default model: alias (opus, sonnet, haiku) or full model ID, optionally with a [1m] context suffix",
      "pattern": "^(opus|sonnet|haiku|claude-[a-z0-9.-]+)(\\[1m\\])?$"
    }
  },
  "definitions": {
    "hookArray": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matcher": {
            "type": "string",
            "description": "Pattern to match for hook activation"
          },
          "hooks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["command"],
                  "description": "Hook type"
                },
                "command": {
                  "type": "string",
                  "description": "Command to execute"
                },
                "async": {
                  "type": "boolean",
                  "description": "Run the hook asynchronously"
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Maximum execution time in seconds"
                }
              },
              "required": ["type", "command"],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
