{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "NODE_ENV": "development",
    "WORKSPACES_STATUSLINE_FALLBACK": "~/.claude/scripts/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(tree *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh repo view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh search *)",
      "Bash(gh status *)",
      "Bash(~/.claude/skills/gh-apps/scripts/gh-apps.py *)",
      "Bash(uv run ~/.claude/skills/cmux-orchestrator/scripts/pr-fetch-context.py *)",
      "Read(~/.ai-memory/**)",
      "Edit(~/.ai-memory/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(secrets/**)",
      "Read(~/.config/**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**/credentials*)",
      "Edit(.env*)",
      "Edit(secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/**/credentials*)"
    ],
    "ask": [
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end.sh",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/team-memory/scripts/session-end.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dotclaude-deploy.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/skills/chronicle/scripts/session-start.ts"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/timeout 5 \"$HOME/.claude/skills/signoz-log/scripts/signoz-log.sh\" INFO 'session started' 2>/dev/null || echo 'signoz-log: start hook timed out'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/timeout 5 ~/.claude/scripts/sync-dotagents.py status 2>/dev/null || echo 'dotagents: status check skipped'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/timeout 5 \"$HOME/.claude/skills/signoz-log/scripts/signoz-log.sh\" INFO 'session stopped' 2>/dev/null || echo 'signoz-log: stop hook timed out'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/workspaces/hook-forwarders/event-forwarder.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/share/workspaces/hook-forwarders/statusline.sh",
    "refreshInterval": 5000
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "verbose": true,
  "preferredNotifChannel": "iterm2",
  "autoMode": {
    "classifyAllShell": true
  },
  "voiceEnabled": true,
  "model": "opus[1m]"
}
