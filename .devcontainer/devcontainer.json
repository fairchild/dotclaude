{
  "name": "dotclaude",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "./setup.sh",
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key. Or skip this and run `claude login` to authenticate via browser."
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
