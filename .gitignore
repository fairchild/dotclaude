# Secrets and credentials (defensive patterns for forks)
.env
.env.*
.env.local
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*credential*
*secret*
.aws/
.ssh/
.gnupg/
secrets/
credentials/

# Auto-memory (cross-session, personal)
memory/

# Session data (personal, ephemeral)
sessions/
history.jsonl
.chronicle-last-sync
plans/
todos/
/session-titles/
session-env/
file-history/
chronicle/blocks/
chronicle/digests/
chronicle/insights/
chronicle/recaps/
chronicle/summaries/
title-feedback/

# Debug and logs
debug/
shell-snapshots/

# Analytics and tracking
statsig/
stats-cache.json
telemetry/

# Python
__pycache__/

# Generated/cached
cache/
downloads/
docs/local/
projects/
plugins/
image-cache/
knowledge/
webui/data.json

# Scripts (track utilities, ignore generated)
scripts/node_modules/
scripts/.gitignore
scripts/bun.lock
scripts/tsconfig.json

# Skill scripts (track code, ignore generated)
skills/*/scripts/node_modules/
skills/*/scripts/test-results/
skills/*/node_modules/
skills/*/bun.lock
.last-run.json

# Session titles data (real session data, not tracked)
skills/session-titles/data/*
!skills/session-titles/data/README.md
!skills/session-titles/data/.gitkeep

# IDE and config state
ide/
config/notification_states.json

# OS files
.DS_Store
Thumbs.db

# Local artifacts
backups/
mcp-needs-auth-cache.json

# Temporary files
.venv/
policy-limits.json
.trash
tmp/
*.tmp
*.cache
*.swp
*~
*.bak.*
scratch/
paste-cache/
cadence/

# Session artifacts
teams/
handoff.md
notes.md
tasks/

# Agent coordination
.agents/

# Skill eval workspaces (skill-creator convention: <name>-workspace/ as sibling)
skills/*-workspace/

# Image generation comparison outputs
skills/image-gen/outputs/*
!skills/image-gen/outputs/README.md
skills/image-gen/data/*
!skills/image-gen/data/README.md

# claude chrome plugin
chrome/

