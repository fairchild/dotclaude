# Runtime state that must never reach this public repo
handoffs/
.claude.json
settings.json.bak*

# The runtime settings file is machine-local: it holds the autoMode environment
# description and whatever Claude Code and other apps write at runtime.
# settings.example.json is the shareable shape.
settings.json

# Private voice + role skills (personal content; see personal-writing-style above)
skills/writing-voice
skills/steward

# Tool-managed: herdr rewrites this on every reinstall, so tracking it would
# recreate the runtime-drift problem settings.json had.
hooks/herdr-agent-state.sh

# Machine-local: hardcodes /Applications/Foundation.app and is useless without
# that app installed.
agents/foundation.md

# defensive: never track key material
*.pem
*.key
