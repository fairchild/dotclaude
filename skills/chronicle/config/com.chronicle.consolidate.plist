<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chronicle.consolidate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/fairchild/.bun/bin/bun</string>
        <string>/Users/fairchild/.claude/skills/chronicle/scripts/consolidate.ts</string>
        <string>--apply</string>
        <string>--drop-pending</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/chronicle-consolidate.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/chronicle-consolidate.err</string>
    <key>WorkingDirectory</key>
    <string>/Users/fairchild/.claude</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/fairchild</string>
        <key>PATH</key>
        <string>/Users/fairchild/.local/bin:/Users/fairchild/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
